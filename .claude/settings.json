{
  "enableArtifact": false,
  "autoMemoryEnabled": false,
  "env": {
    "ENABLE_CLAUDEAI_MCP_SERVERS": "false",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "DISABLE_FEEDBACK_COMMAND": "1"
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(node *)",
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(winget install *)",
      "Bash(ls *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "PowerShell(node *)",
      "PowerShell(git *)",
      "PowerShell(gh *)",
      "PowerShell(winget install *)",
      "PowerShell(Get-ChildItem *)",
      "PowerShell(New-Item *)",
      "PowerShell(Copy-Item *)",
      "PowerShell(Move-Item *)",
      "Glob",
      "Grep"
    ],
    "deny": [
      "Artifact",
      "Agent",
      "WebSearch",
      "WebFetch",
      "Workflow",
      "Skill",
      "RemoteTrigger",
      "CronCreate",
      "DesignSync",
      "PushNotification",
      "AskUserQuestion",
      "EnterPlanMode",
      "mcp__*",
      "Read(secrets/**)",
      "Read(**/*adminsdk*.json)",
      "Bash(cat secrets*)",
      "Bash(type secrets*)",
      "PowerShell(Get-Content secrets*)",
      "Bash(rm -r*)",
      "Bash(rm -fr*)",
      "Bash(git push --force*)",
      "PowerShell(git push --force*)",
      "PowerShell(Remove-Item *-Recurse*)"
    ]
  }
}
